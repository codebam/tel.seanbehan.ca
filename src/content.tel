pub fn quickstart() -> Any:
  [
    {
      n: "1",
      title: "Start a project",
      note: "Nothing to install globally: npx fetches the published @codebam/tel package. tel init writes main.tel and the 2,193-token AGENTS.md contract.",
      code: code('mkdir app && cd app', 'npx @codebam/tel init')
    },
    {
      n: "2",
      title: "Run it",
      note: "The interpreter calls fn main(args). No build step and no dependencies to wire up.",
      code: code('npx @codebam/tel run main.tel -- world')
    },
    {
      n: "3",
      title: "Check and build",
      note: "Static diagnostics in file:line:col, then typed ESM for Node or a browser bundle with --target web.",
      code: code('npx @codebam/tel check main.tel', 'npx @codebam/tel build main.tel --target ts --outdir out')
    }
  ]

pub fn faqs() -> Any:
  [
    {
      q: "How do I run it?",
      a: "Install Node >= 20 and run npx @codebam/tel. The published package is @codebam/tel, so there is no global install: npx @codebam/tel init writes main.tel plus the AGENTS.md guide, and npx @codebam/tel run main.tel executes it."
    },
    {
      q: "Is Tel production-ready?",
      a: "Tel is v0.2. The runtime, compiler, checker and formatter are covered by a 94-test verification suite, and known limitations are documented. It is young, but already pleasant for small tools, APIs and prototypes."
    },
    {
      q: "How is this different from just writing TypeScript?",
      a: "TypeScript is one of Tel's compile targets. Tel adds a Python-style surface, a higher-level stdlib, built-in checking and token-lean idioms for AI-authored code, then emits typed ESM you can read, review and deploy."
    },
    {
      q: "Can I use npm packages?",
      a: "Yes. Default, named and namespace imports work, Tel lambdas are JavaScript arrows, and await works on promises. Packages must be installed exactly as in Node; the Tel toolchain itself needs none."
    },
    {
      q: "Does it run on Cloudflare Workers?",
      a: "This site does. Tel compiles to a standalone ESM module; a small generated wrapper turns its exported fetch handler into a Worker default export. The HTML you are reading, the JSON APIs and the browser island are all compiled from Tel."
    },
    {
      q: "How big is a compiled program?",
      a: "Each compiled file inlines the shared runtime, so a hello-world bundle is roughly 28 KB before gzip. There are no runtime npm dependencies, and the Worker here needs no Node compatibility flags."
    },
    {
      q: "Is there tooling for agents?",
      a: "Yes: npx @codebam/tel check gives file:line:col diagnostics, fmt canonicalizes layout, tokens reports exact cl100k_base counts, and init installs the AGENTS.md contract into a project."
    },
    {
      q: "What is the license?",
      a: "MIT."
    }
  ]
